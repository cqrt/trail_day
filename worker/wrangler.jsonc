{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trailday-doc-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "doc-api.trailday.app",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
