<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A tramper mid-stride: pack on the back, one pole planted ahead.

         The figure is drawn at 0.76 about the middle of the 108 units, and that number is not a
         taste: a launcher shows only the middle 72 of this layer, so the 18-to-90 band is the edge of
         the icon and not a margin inside it. At 1.0 the walker stood from 24 to 88 and filled the
         circle to the edge the moment it was on a phone. At 0.76 it stands from 30 to 79 and keeps
         about twelve units of slate all round. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.76"
        android:scaleY="0.76"
        android:translateY="-1.5">

        <!-- The pack, in the map's gold, sitting high on the shoulders and tipped back a little. -->
        <group
            android:pivotX="40"
            android:pivotY="34"
            android:rotation="-10">
            <path
                android:fillColor="#F2E3A8"
                android:pathData="M39,28 H44 A6,6 0 0 1 50,34 V35 A6,6 0 0 1 44,41 H39 A6,6 0 0 1 33,35 V34 A6,6 0 0 1 39,28 Z" />
        </group>
        <group
            android:pivotX="36"
            android:pivotY="50"
            android:rotation="-10">
            <path
                android:fillColor="#F2E3A8"
                android:pathData="M37,40 H38 A9,9 0 0 1 47,49 V51 A9,9 0 0 1 38,60 H37 A9,9 0 0 1 28,51 V49 A9,9 0 0 1 37,40 Z" />
        </group>

        <!-- Head, torso and both legs in one colour, in heavy round-capped strokes: that heaviness is
             what survives being drawn at 48 pixels on a home screen. It was 16, 12.5 and 11 to begin
             with, and at 38 pixels the two legs met in the middle and the arm was lost in the torso, so
             the walker was one white pear. The widths that keep a gap between the legs and let the arm
             show are 12.5, 10.5 and 9.2, with the head at 7.6 and the pack pulled in by the same
             hand: at that size the stride reads as two legs rather than one. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M55.4,32 A7.6,7.6 0 1 0 70.6,32 A7.6,7.6 0 1 0 55.4,32 Z" />
        <path
            android:pathData="M59,44 L53,63"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M53,63 L61,73 L59,82"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M53,63 L45,73 L37,81"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- The arm reaching forward to the pole, then the pole itself, gold and thin so it reads as
             something held rather than part of the body. -->
        <path
            android:pathData="M61,47 L72,53 L74,60"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="9.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M78,38 L71,84"
            android:strokeColor="#F2E3A8"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M76,38 H80"
            android:strokeColor="#F2E3A8"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
    </group>
</vector>
