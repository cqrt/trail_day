<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Basemap tiles (one-off downloads for offline regions) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS track recording -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Serving the track editor over the Wi-Fi, while its switch is on -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Serving the editor with the phone asleep: the page is read from a laptop while the phone is
        in a pocket, and a suspended CPU cannot finish a tile the phone has to go and fetch. Held
        only for the life of the run. A Wi-Fi lock needs this permission too.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Installing a downloaded update over this copy of the app. This only lets the
        request be made: Android still asks the walker to confirm every time, and an APK
        signed with a different key is refused by the installer whatever this says.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The app is fully usable without a GPS chip (tracks can be drawn/imported) -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".TrailDayApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrailDay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TrailDay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Location-typed foreground service. Only started from the visible UI,
            which is why ACCESS_BACKGROUND_LOCATION is not needed.
        -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            The editor, served to a computer on the same Wi-Fi. Data-sync typed because what it
            does is serve data, and only ever started from the switch on the Settings screen - so
            the phone is listening on the network only while somebody has asked it to.
        -->
        <service
            android:name=".web.WebEditorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Receives the installer's answer to a committed update session. Declared here
            rather than registered by the screen that started it, because the answer can
            arrive after this app's process has been replaced.
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!--
            The camera writes the full-size original of a waypoint photograph into the app's cache.
            It is read back, scaled and stored, then deleted; nothing outside the app can browse the
            provider.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
